{
  "name": "@bbr/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "console": "node dist/apps/api/src/console.js",
    "console:dev": "ts-node -r tsconfig-paths/register src/console.ts",
    "copy-env": "shx cp .env.example .env",
    "dev": "cross-env NODE_ENV=development pnpm run start:dev",
    "dev:fixtures": "pnpm run console:dev fixtures",
    "fixtures": "pnpm run console fixtures",
    "dev:seeders": "pnpm run console:dev seeders",
    "seeders": "pnpm run console seeders",
    "dev:mongo": "ts-node ./scripts/devMongo.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "gen2": "ts-node generator/index.ts",
    "lint": "eslint \"{src,apps,libs,test,json}/**/*.ts\" --fix",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/api/src/main.js",
    "test": "pnpm copy-env; jest --maxWorkers=50% --workerIdleMemoryLimit='1024MB'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.622.0",
    "@aws-sdk/lib-storage": "^3.622.0",
    "@bbr/api-core": "workspace:^",
    "@joi/date": "^2.1.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^9.4.3",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^10.3.10",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^9.4.3",
    "@nestjs/swagger": "^7.3.1",
    "@types/axios": "^0.14.0",
    "@types/express": "^4.17.21",
    "@types/formidable": "^3.4.5",
    "argon2": "^0.40.3",
    "axios": "^1.7.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-csv": "^5.0.1",
    "formidable": "^3.5.1",
    "handlebars": "^4.7.8",
    "inquirer": "8.0.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "moment": "^2.30.1",
    "mongoose": "^8.5.1",
    "nestjs-joi": "^1.10.0",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "rxjs": "^7.8.1",
    "short-uuid": "^5.2.0",
    "stripe": "^16.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@bbr/prettier": "workspace:^",
    "@nestjs/cli": "^9.5.0",
    "@nestjs/schematics": "^9.2.0",
    "@nestjs/testing": "^10.3.10",
    "@types/jest": "^29.5.12",
    "@types/node": "18.11.18",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "29.3.1",
    "msw": "^2.2.13",
    "prettier": "^3.2.5",
    "prettier-plugin-packagejson": "^2.4.14",
    "shx": "^0.3.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.9.5"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "node",
      "a"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)": "<rootDir>/$1"
    },
    "testTimeout": 15000,
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "globalSetup": "<rootDir>/../node_modules/@bbr/api-core/modules/testing/setup.ts",
    "globalTeardown": "<rootDir>/../node_modules/@bbr/api-core/modules/testing/teardown.ts"
  }
}