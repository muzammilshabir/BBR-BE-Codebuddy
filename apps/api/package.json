{
  "name": "@bbr/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "console": "node dist/src/console.js",
    "console:dev": "ts-node -r tsconfig-paths/register src/console.ts",
    "copy-env": "shx cp .env.example .env",
    "dev": "cross-env NODE_ENV=development pnpm run start:dev",
    "dev:fixtures": "pnpm run console:dev fixtures",
    "dev:seeders": "pnpm run console:dev seeders",
    "dev:mongo": "ts-node ./scripts/devMongo.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "gen2": "ts-node generator/index.ts",
    "lint": "eslint \"{src,apps,libs,test,json}/**/*.ts\" --fix",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/api/src/main.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all"
  },
  "dependencies": {
    "@bbr/api-core": "workspace:^",
    "@joi/date": "^2.1.1",
    "@nestjs/common": "^9.4.3",
    "@nestjs/config": "^2.3.4",
    "@nestjs/core": "^10.3.7",
    "@nestjs/platform-express": "^9.4.3",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/swagger": "^7.3.1",
    "@types/express": "^4.17.21",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "inquirer": "8.0.0",
    "joi": "^17.13.1",
    "nestjs-joi": "^1.10.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@bbr/prettier": "workspace:^",
    "@nestjs/cli": "^9.5.0",
    "@nestjs/schematics": "^9.2.0",
    "@types/node": "18.11.18",
    "@types/sequelize": "^4.28.20",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "29.3.1",
    "msw": "^2.2.13",
    "prettier": "^3.2.5",
    "prettier-plugin-packagejson": "^2.4.14",
    "shx": "^0.3.4",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.9.5"
  }
}