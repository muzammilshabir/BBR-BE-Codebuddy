# App
NODE_ENV="development"
APP_NAME="NestApp"
SERVICE_URL="http://localhost:4001"
FRONTEND_URL="http://localhost:4001"
ADMIN_FRONTEND_URL="http://localhost:4001"

# AWS
AWS_S3_BUCKET_REGION="eu-central-1"
AWS_S3_USER_ACCESS_KEY_ID="003b33dummydb0000000002"
AWS_S3_USER_SECRET="dummyUserSecret"
AWS_S3_BUCKET_NAME="dummyBacketName"
END_POINT=
CDN_URL="dummy.cloudfront.net"

# Mail
NODMAILER_PORT=587
NODMAILER_USER="dummyUser"
NODMAILER_PASS="username"
NODMAILER_HOST="smtp.example.com"
MAILER_FROM="dummyUser@company.com"

DB_URI='mongodb://localhost:27017/BbrBackend'
JWT_AT_SECRET="dummy_jwt_secret_key@123"
JWT_RT_SECRET="dummy_jwt_secret_key@123"
ENCRYPTION_SECRET_KEY="BBR_secure_key"


# Redis
APP_REDIS_USER="default"
APP_REDIS_HOST="localhost"
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0
APP_REDIS_APP_PREFIX=brr_api_local
APP_REDIS_DEFAULT_EXPIRY=3600 # in seconds


# Google
CAPTCHA_SECRET=
# Disable CAPTCHA for Unit/Integration Tests
CAPTCHA_DISABLED=1

#FCM
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
